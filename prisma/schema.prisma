generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  password    String
  isAdmin     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  predictions Prediction[]
  specialPick SpecialPick?
  league      League?      @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  leagueId    String?
}

model League {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  users      User[]
}

model Match {
  id          String       @id @default(cuid())
  matchNumber Int          @unique
  group       String?
  round       String
  homeTeam    String
  awayTeam    String
  kickoff     DateTime
  venue       String
  result      Result?
  locked      Boolean      @default(false)
  predictions Prediction[]

  @@index([round])
  @@index([group])
}

enum Result {
  HOME
  DRAW
  AWAY
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  pick      Result
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
}

model SpecialPick {
  id         String   @id @default(cuid())
  userId     String   @unique
  champions  String[]
  topScorers String[]
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model SpecialPickLock {
  id                String    @id @default("global")
  championLockedAt  DateTime?
  topScorerLockedAt DateTime?
  updatedAt         DateTime  @updatedAt
}

model TournamentResult {
  id        String   @id @default(cuid())
  champion  String?
  topScorer String?
  updatedAt DateTime @updatedAt
}

model ChampionCandidate {
  id   String @id @default(cuid())
  name String @unique
}

model TopScorerCandidate {
  id      String @id @default(cuid())
  name    String @unique
  country String
}

model Team {
  id   String @id @default(cuid())
  name String @unique
}
